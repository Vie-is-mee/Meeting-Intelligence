  "cases": [
    {
      "id": "LONG01",
      "split": "development",
      "result": "COMPLETED",
      "output": {
        "engine": "llm_api",
        "utterances": [
          {
            "id": "L001",
            "order": 1,
            "text": "Hôm nay cần chốt phương thức lưu trữ, việc sửa thanh toán và kế hoạch kiểm thử.",
            "speaker": "An",
            "timestamp": null
          },
          {
            "id": "L002",
            "order": 2,
            "text": "Tôi đề xuất lưu tệp trên ổ cứng máy chủ.",
            "speaker": "Bình",
            "timestamp": null
          },
          {
            "id": "L003",
            "order": 3,
            "text": "Nếu chạy hai máy chủ thì lưu trên ổ cứng khó đồng bộ.",
            "speaker": "Chi",
            "timestamp": null
          },
          {
            "id": "L004",
            "order": 4,
            "text": "Chưa chốt phương án lưu trữ, sang việc thanh toán trước.",
            "speaker": "An",
            "timestamp": null
          },
          {
            "id": "L005",
            "order": 5,
            "text": "Có lỗi thanh toán làm khách bị trừ hai lần.",
            "speaker": "Lan",
            "timestamp": null
          },
          {
            "id": "L006",
            "order": 6,
            "text": "Cái này team mình xử lý nhé.",
            "speaker": "An",
            "timestamp": null
          },
          {
            "id": "L007",
            "order": 7,
            "text": "Tôi nhận xử lý lỗi trừ tiền hai lần trước thứ Sáu.",
            "speaker": "Huy",
            "timestamp": null
          },
          {
            "id": "L008",
            "order": 8,
            "text": "Xác nhận Huy xử lý lỗi thanh toán trước thứ Sáu.",
            "speaker": "An",
            "timestamp": null
          },
          {
            "id": "L009",
            "order": 9,
            "text": "Ta quay lại lưu trữ: tôi rút đề xuất ổ cứng.",
            "speaker": "Bình",
            "timestamp": null
          },
          {
            "id": "L010",
            "order": 10,
            "text": "Chuyển sang object storage sẽ dễ mở rộng.",
            "speaker": "Chi",
            "timestamp": null
          },
          {
            "id": "L011",
            "order": 11,
            "text": "Chốt object storage cho bản thử nghiệm, còn nhà cung cấp chọn ở cuộc họp khác.",
            "speaker": "An",
            "timestamp": null
          },
          {
            "id": "L012",
            "order": 12,
            "text": "Tôi nhận chuẩn bị bảng so sánh giá nhà cung cấp vào thứ Hai.",
            "speaker": "Mai",
            "timestamp": null
          },
          {
            "id": "L013",
            "order": 13,
            "text": "Được, Mai chuẩn bị bảng giá trước thứ Hai.",
            "speaker": "An",
            "timestamp": null
          },
          {
            "id": "L014",
            "order": 14,
            "text": "Khi retry API cần dùng idempotency key để tránh ghi trùng. Đây là kinh nghiệm dự án trước.",
            "speaker": "Kiên",
            "timestamp": null
          },
          {
            "id": "L015",
            "order": 15,
            "text": "Nghe nói thư viện thanh toán Z nhanh nhất, nhưng chưa đo thực tế.",
            "speaker": "Lan",
            "timestamp": null
          },
          {
            "id": "L016",
            "order": 16,
            "text": "Chưa thể coi thư viện Z nhanh hơn nếu chưa benchmark.",
            "speaker": "An",
            "timestamp": null
          },
          {
            "id": "L017",
            "order": 17,
            "text": "Tôi gặp trở ngại do không có quyền xem báo giá.",
            "speaker": "Mai",
            "timestamp": null
          },
          {
            "id": "L018",
            "order": 18,
            "text": "Tạm dừng việc chuẩn bị bảng giá, hủy deadline thứ Hai để xin quyền.",
            "speaker": "An",
            "timestamp": null
          },
          {
            "id": "L019",
            "order": 19,
            "text": "Tôi hiểu việc được tạm dừng; chưa hẹn ngày mới.",
            "speaker": "Mai",
            "timestamp": null
          },
          {
            "id": "L020",
            "order": 20,
            "text": "Kết luận: object storage đã chốt, nhà cung cấp còn mở, Huy vẫn xử lý lỗi thanh toán.",
            "speaker": "An",
            "timestamp": null
          }
        ],
