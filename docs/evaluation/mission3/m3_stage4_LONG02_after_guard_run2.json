      "output": {
        "engine": "llm_api",
        "utterances": [
          {
            "id": "L001",
            "order": 1,
            "text": "Hôm nay bàn lựa chọn đồng bộ dữ liệu và phân công đội kiểm thử.",
            "speaker": "Diệp",
            "timestamp": null
          },
          {
            "id": "L002",
            "order": 2,
            "text": "Chúng ta có hai cách: đồng bộ tự động hoặc thủ công.",
            "speaker": "Sang",
            "timestamp": null
          },
          {
            "id": "L003",
            "order": 3,
            "text": "Tôi nhận viết danh sách quyền cần xin, chưa chốt deadline.",
            "speaker": "Huy",
            "timestamp": null
          },
          {
            "id": "L004",
            "order": 4,
            "text": "Chốt bật đồng bộ tự động nếu bảo mật phê duyệt quyền đọc dữ liệu.",
            "speaker": "Diệp",
            "timestamp": null
          },
          {
            "id": "L005",
            "order": 5,
            "text": "Bảo mật chưa xem xong phạm vi thông tin cá nhân.",
            "speaker": "Lan",
            "timestamp": null
          },
          {
            "id": "L006",
            "order": 6,
            "text": "Mình có nên giao Huy kiểm thử API thứ Sáu được không?",
            "speaker": "Chi",
            "timestamp": null
          },
          {
            "id": "L007",
            "order": 7,
            "text": "Chưa chốt hạn kiểm thử API, cũng chưa phân công người.",
            "speaker": "Diệp",
            "timestamp": null
          },
          {
            "id": "L008",
            "order": 8,
            "text": "Đối với module thông báo, chúng ta đang theo cách gửi theo lô.",
            "speaker": "Kiên",
            "timestamp": null
          },
          {
            "id": "L009",
            "order": 9,
            "text": "Phần cấu hình gửi email cần rà soát trước buổi thử tiếp theo.",
            "speaker": "Sang",
            "timestamp": null
          },
          {
            "id": "L010",
            "order": 10,
            "text": "Hay đặt hạn thứ Ba?",
            "speaker": "Kiên",
            "timestamp": null
          },
          {
            "id": "L011",
            "order": 11,
            "text": "Hay thứ Năm?",
            "speaker": "Sang",
            "timestamp": null
          },
          {
            "id": "L012",
            "order": 12,
            "text": "Chưa chọn ngày cho cấu hình email, chưa biết ai nhận việc.",
            "speaker": "Diệp",
            "timestamp": null
          },
          {
            "id": "L013",
            "order": 13,
            "text": "Việc danh sách quyền vẫn do tôi phụ trách, dù đồng bộ chưa chốt.",
            "speaker": "Huy",
            "timestamp": null
          },
          {
            "id": "L014",
            "order": 14,
            "text": "Tôi mở lại lựa chọn đồng bộ tự động, chưa quyết định bật hay giữ thủ công.",
            "speaker": "Diệp",
            "timestamp": null
          },
          {
            "id": "L015",
            "order": 15,
            "text": "Vấn đề quyền dữ liệu cá nhân còn mở.",
            "speaker": "Sang",
            "timestamp": null
          },
          {
            "id": "L016",
            "order": 16,
            "text": "Để team mình xem phần kiểm thử API nhé.",
            "speaker": "Chi",
            "timestamp": null
          },
          {
            "id": "L017",
            "order": 17,
            "text": "Đúng, chưa giao cá nhân nào phụ trách kiểm thử API.",
            "speaker": "Diệp",
            "timestamp": null
          },
          {
            "id": "L018",
            "order": 18,
            "text": "Hãy ghi rõ các mục chưa xác định thay vì tự điền người hoặc ngày.",
            "speaker": "Diệp",
            "timestamp": null
          }
