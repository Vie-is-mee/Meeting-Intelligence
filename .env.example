# Suggested Groq configuration; model quality still requires live evaluation.
# NEVER upload real values to GitHub.
# Copy to .env; Python loads .env automatically without overriding environment variables.
LLM_API_KEY=replace-with-private-token
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Set false only if provider refuses response_format=json_object but can follow prompt JSON output.
LLM_JSON_MODE=true
# auto: strict JSON Schema on Groq GPT-OSS 20B/120B; other providers use JSON mode.
# off: use legacy JSON mode; strict: explicitly require schema support from provider.
LLM_STRUCTURED_OUTPUTS=auto
# Explicit extraction budget; audit uses 1024. Avoid reserving more than the free TPM limit.
LLM_MAX_COMPLETION_TOKENS=2560
LLM_TEMPERATURE=0.6
LLM_REASONING_EFFORT=low
